{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "desktop-dist",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["electron/**/*.mts", "electron/**/*.cts"]
}